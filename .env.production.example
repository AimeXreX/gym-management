APP_NAME="Gym SaaS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gym.example.com
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Tehran
BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=
SESSION_LIFETIME=
SESSION_ENCRYPT=
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=
SESSION_SAME_SITE=
QUEUE_CONNECTION=database
CACHE_STORE=file
FILESYSTEM_DISK=local
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
BACKUP_PATH=/home/ACCOUNT/private-backups/gym
BACKUP_RETENTION=7
BACKUP_MAX_AGE_HOURS=30
BACKUP_ENCRYPTION_PASSWORD=
MYSQLDUMP_PATH=mysqldump
ALLOW_TEST_ACCOUNTS=false
